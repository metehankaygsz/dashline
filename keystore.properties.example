# Copy to "keystore.properties" and fill in your own values.
# keystore.properties is gitignored — never commit it, and never commit the .jks.
#
# Create a key first (choose your own password when prompted):
#
#   keytool -genkey -v -keystore release.jks -alias release \
#           -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=release
keyPassword=CHANGE_ME
