<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown in place of a widget whose provider isn't answering — usually because
  its app is being updated. The widget stays in the user's settings; this is a
  temporary stand-in, not a removal.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:alpha="0.6"
        app:srcCompat="@drawable/ic_apps" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/widget_unavailable"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
