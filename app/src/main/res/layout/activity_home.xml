<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ===== Top status bar: home | favorites dock | wifi ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bar_height"
        android:background="@color/bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/homeButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/tab_apps"
            app:srcCompat="@drawable/ic_home" />

        <!-- Favorite-apps dock (quick launch). Slots are bound in code. -->
        <LinearLayout
            android:id="@+id/favoritesDock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/favSlot0" style="@style/FavSlot" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/favSlot1" style="@style/FavSlot" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/favSlot2" style="@style/FavSlot" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/favSlot3" style="@style/FavSlot" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/favSlot4" style="@style/FavSlot" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/wifiIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/tab_settings"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_wifi" />
    </LinearLayout>

    <!-- ===== Middle: map (left) + panel (right) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="8dp">

        <!-- Clock + weather dashboard -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.35"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/panel_padding"
            android:background="@drawable/card_dark">


            <!-- Analog face — shown instead of bigClock when that style is picked -->
            <com.dashline.launcher.AnalogClockView
                android:id="@+id/analogClock"
                android:layout_width="@dimen/analog_clock"
                android:layout_height="@dimen/analog_clock"
                android:visibility="gone" />
            <TextView
                android:id="@+id/bigClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/clock_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bigDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/date_margin_bottom"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/date_text" />
            <!-- Stopwatch — hidden unless enabled in Settings -->
            <LinearLayout
                android:id="@+id/chronoRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/chronoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:minWidth="@dimen/chrono_width"
                    android:text="0:00.00"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/chrono_text"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/chronoToggle"
                    android:layout_width="@dimen/chrono_button"
                    android:layout_height="@dimen/chrono_button"
                    android:padding="10dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/chrono_start_stop"
                    app:srcCompat="@drawable/ic_play" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/chronoReset"
                    android:layout_width="@dimen/chrono_button"
                    android:layout_height="@dimen/chrono_button"
                    android:padding="10dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/chrono_reset"
                    app:srcCompat="@drawable/ic_reset" />
            </LinearLayout>


            <!-- Weather row: icon + temperature + description -->
            <LinearLayout
                android:id="@+id/weatherRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/weatherIcon"
                    android:layout_width="@dimen/weather_icon"
                    android:layout_height="@dimen/weather_icon"
                    android:layout_marginEnd="14dp"
                    android:contentDescription="@string/settings_temp_unit"
                    app:srcCompat="@drawable/ic_wx_cloudy" />

                <TextView
                    android:id="@+id/weatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/weather_temp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/weatherDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weather_loading"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/weather_desc" />
            </LinearLayout>

            <!-- Upcoming-days forecast strip -->
            <LinearLayout
                android:id="@+id/forecastRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/forecast_margin_top"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone">

                <LinearLayout style="@style/FcCell">
                    <TextView android:id="@+id/fc0Day" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/fc0Icon"
                        android:layout_width="@dimen/forecast_icon" android:layout_height="@dimen/forecast_icon"
                        android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                        android:contentDescription="@null" app:srcCompat="@drawable/ic_wx_cloudy" />
                    <TextView android:id="@+id/fc0Temp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout style="@style/FcCell">
                    <TextView android:id="@+id/fc1Day" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/fc1Icon"
                        android:layout_width="@dimen/forecast_icon" android:layout_height="@dimen/forecast_icon"
                        android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                        android:contentDescription="@null" app:srcCompat="@drawable/ic_wx_cloudy" />
                    <TextView android:id="@+id/fc1Temp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout style="@style/FcCell">
                    <TextView android:id="@+id/fc2Day" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/fc2Icon"
                        android:layout_width="@dimen/forecast_icon" android:layout_height="@dimen/forecast_icon"
                        android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                        android:contentDescription="@null" app:srcCompat="@drawable/ic_wx_cloudy" />
                    <TextView android:id="@+id/fc2Temp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Phone-projection shortcuts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/shortcut_margin_top"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/shortcutAndroidAuto"
                    style="@style/ProjectionTile">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_android_auto" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/shortcut_android_auto"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shortcutCarPlay"
                    style="@style/ProjectionTile">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_carplay" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/shortcut_carplay"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Right column: media widget + phone card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Media player widget (real now-playing when available) -->
            <LinearLayout
                android:id="@+id/mediaCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@drawable/card_blue"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Album art: rounded bitmap set in code, on a rounded tile -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/mediaArt"
                        android:layout_width="@dimen/album_art"
                        android:layout_height="@dimen/album_art"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/art_bg"
                        android:padding="@dimen/album_art_padding"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/tab_audio"
                        app:srcCompat="@drawable/ic_audio" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/mediaTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="marquee"
                            android:singleLine="true"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:text="@string/now_playing"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/media_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/mediaArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text=""
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Seek row: elapsed | bar | total (hidden when no duration) -->
                <LinearLayout
                    android:id="@+id/mediaSeekRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/mediaElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="34dp"
                        android:text="0:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/mediaProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxHeight="4dp"
                        android:minHeight="4dp"
                        android:progressDrawable="@drawable/seek_progress"
                        android:thumb="@drawable/seek_thumb"
                        android:thumbOffset="0dp" />

                    <TextView
                        android:id="@+id/mediaTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="34dp"
                        android:gravity="end"
                        android:text="0:00"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Transport controls (hidden when nothing is playing) -->
                <LinearLayout
                    android:id="@+id/mediaControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnPrev"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="9dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/media_previous"
                        app:srcCompat="@drawable/ic_skip_previous" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnPlayPause"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="18dp"
                        android:layout_marginEnd="18dp"
                        android:padding="12dp"
                        android:background="@drawable/btn_circle"
                        android:contentDescription="@string/media_play_pause"
                        app:srcCompat="@drawable/ic_play" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btnNext"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:padding="9dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/media_next"
                        app:srcCompat="@drawable/ic_skip_next" />
                </LinearLayout>

                <!-- Media volume — always available, unlike the transport controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/volumeIcon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="6dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/volume_mute"
                        app:srcCompat="@drawable/ic_volume" />

                    <SeekBar
                        android:id="@+id/volumeSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:maxHeight="4dp"
                        android:minHeight="4dp"
                        android:progressDrawable="@drawable/seek_progress"
                        android:thumb="@drawable/seek_thumb"
                        android:thumbOffset="0dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Phone -->
            <!-- Hugs its content so the media card above takes the leftover height,
                 instead of both stretching and leaving large gaps. -->
            <LinearLayout
                android:id="@+id/phoneCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/phone_card_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/card_dark"
                android:foreground="?android:attr/selectableItemBackground">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/tab_phone"
                    app:srcCompat="@drawable/ic_phone" />

                <TextView
                    android:id="@+id/phoneLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tab_phone"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Bottom tab bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/tabBar"
        android:layout_height="@dimen/tab_bar_height"
        android:orientation="horizontal"
        android:background="@color/bar"
        android:baselineAligned="false">
    </LinearLayout>
</LinearLayout>
