<?xml version="1.0" encoding="utf-8"?>
<!--
  Portrait variant for upright head units. Same views and the same ids as the
  landscape layout — ViewBinding merges variants and would make any id missing
  here nullable, breaking HomeActivity — just stacked instead of side by side.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ===== Top status bar ===== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bar_height"
        android:background="@color/bar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/homeButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/tab_apps"
            app:srcCompat="@drawable/ic_home" />

        <LinearLayout
            android:id="@+id/favoritesDock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/wifiIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/tab_settings"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_wifi" />
    </LinearLayout>

    <!-- ===== Stacked content ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Clock + weather -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/panel_padding"
                android:background="@drawable/card_dark">


                <!-- Analog face — shown instead of bigClock when that style is picked -->
                <com.dashline.launcher.AnalogClockView
                    android:id="@+id/analogClock"
                    android:layout_width="@dimen/analog_clock"
                    android:layout_height="@dimen/analog_clock"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/bigClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/clock_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bigDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/date_margin_bottom"
                    android:text=""
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/date_text" />
                <!-- Stopwatch — hidden unless enabled in Settings -->
                <LinearLayout
                    android:id="@+id/chronoRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/chronoText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:minWidth="86dp"
                        android:text="0:00.0"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/chronoToggle"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:padding="8dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/chrono_start_stop"
                        app:srcCompat="@drawable/ic_play" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/chronoReset"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:padding="8dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/chrono_reset"
                        app:srcCompat="@drawable/ic_reset" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/weatherRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/weatherIcon"
                        android:layout_width="@dimen/weather_icon"
                        android:layout_height="@dimen/weather_icon"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@string/settings_temp_unit"
                        app:srcCompat="@drawable/ic_wx_cloudy" />

                    <TextView
                        android:id="@+id/weatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text=""
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/weather_temp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weatherDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weather_loading"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/weather_desc" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/forecastRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/forecast_margin_top"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:visibility="gone">

                    <LinearLayout style="@style/FcCell">
                        <TextView android:id="@+id/fc0Day" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/fc0Icon"
                            android:layout_width="@dimen/forecast_icon" android:layout_height="@dimen/forecast_icon"
                            android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                            android:contentDescription="@null" app:srcCompat="@drawable/ic_wx_cloudy" />
                        <TextView android:id="@+id/fc0Temp" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout style="@style/FcCell">
                        <TextView android:id="@+id/fc1Day" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/fc1Icon"
                            android:layout_width="@dimen/forecast_icon" android:layout_height="@dimen/forecast_icon"
                            android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                            android:contentDescription="@null" app:srcCompat="@drawable/ic_wx_cloudy" />
                        <TextView android:id="@+id/fc1Temp" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout style="@style/FcCell">
                        <TextView android:id="@+id/fc2Day" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/fc2Icon"
                            android:layout_width="@dimen/forecast_icon" android:layout_height="@dimen/forecast_icon"
                            android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                            android:contentDescription="@null" app:srcCompat="@drawable/ic_wx_cloudy" />
                        <TextView android:id="@+id/fc2Temp" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/shortcut_margin_top"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout android:id="@+id/shortcutAndroidAuto" style="@style/ProjectionTile">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="22dp" android:layout_height="22dp"
                            android:layout_marginEnd="8dp" android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_android_auto" />
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:maxLines="1" android:ellipsize="end"
                            android:text="@string/shortcut_android_auto"
                            android:textColor="@color/text_primary" android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/shortcutCarPlay" style="@style/ProjectionTile">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="22dp" android:layout_height="22dp"
                            android:layout_marginEnd="8dp" android:contentDescription="@null"
                            app:srcCompat="@drawable/ic_carplay" />
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:maxLines="1" android:ellipsize="end"
                            android:text="@string/shortcut_carplay"
                            android:textColor="@color/text_primary" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Media -->
            <LinearLayout
                android:id="@+id/mediaCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@drawable/card_blue"
                android:foreground="?android:attr/selectableItemBackground">
                <!-- Default: the media player itself -->
                <LinearLayout
                    android:id="@+id/mediaDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/mediaArt"
                            android:tag="noTint"
                            android:layout_width="@dimen/album_art"
                            android:layout_height="@dimen/album_art"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/art_bg"
                            android:padding="@dimen/album_art_padding"
                            android:scaleType="centerCrop"
                            android:contentDescription="@string/tab_audio"
                            app:srcCompat="@drawable/ic_audio" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/mediaTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="marquee"
                                android:singleLine="true"
                                android:marqueeRepeatLimit="marquee_forever"
                                android:text="@string/now_playing"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/media_title"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/mediaArtist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text=""
                                android:textColor="@color/text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/mediaSeekRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/mediaElapsed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="34dp"
                            android:text="0:00"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/mediaProgress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxHeight="4dp"
                            android:minHeight="4dp"
                            android:progressDrawable="@drawable/seek_progress"
                            android:thumb="@drawable/seek_thumb"
                            android:thumbOffset="0dp" />

                        <TextView
                            android:id="@+id/mediaTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="34dp"
                            android:gravity="end"
                            android:text="0:00"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/mediaControls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:visibility="gone">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/btnPrev"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:padding="9dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/media_previous"
                            app:srcCompat="@drawable/ic_skip_previous" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/btnPlayPause"
                            android:tag="noTint"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="18dp"
                            android:layout_marginEnd="18dp"
                            android:padding="12dp"
                            android:background="@drawable/btn_circle"
                            android:contentDescription="@string/media_play_pause"
                            app:srcCompat="@drawable/ic_play" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/btnNext"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:padding="9dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/media_next"
                            app:srcCompat="@drawable/ic_skip_next" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/mediaVolumeRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/volumeIcon"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:padding="6dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/volume_mute"
                            app:srcCompat="@drawable/ic_volume" />

                        <SeekBar
                            android:id="@+id/volumeSlider"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:maxHeight="4dp"
                            android:minHeight="4dp"
                            android:progressDrawable="@drawable/seek_progress"
                            android:thumb="@drawable/seek_thumb"
                            android:thumbOffset="0dp" />
                    </LinearLayout>
            
                </LinearLayout>

                <!-- Or: user-chosen app shortcuts, populated in code -->
                <LinearLayout
                    android:id="@+id/mediaShortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:visibility="gone" />

                <!-- Or: hosted Android app widgets, side by side -->
                <LinearLayout
                    android:id="@+id/mediaWidget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Phone -->
            <LinearLayout
                android:id="@+id/phoneCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/card_dark"
                android:foreground="?android:attr/selectableItemBackground">

                <!-- Default: a plain Phone shortcut -->
                <LinearLayout
                    android:id="@+id/phoneDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@string/tab_phone"
                        app:srcCompat="@drawable/ic_phone" />

                    <TextView
                        android:id="@+id/phoneLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_phone"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Or: user-chosen app shortcuts, populated in code -->
                <LinearLayout
                    android:id="@+id/panelShortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:visibility="gone" />

                <!-- Or: a hosted Android app widget -->
                <LinearLayout
                    android:id="@+id/panelWidget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Portrait app drawer: fills the space left under the cards.
                 Present in landscape too (kept gone) only so ViewBinding sees the
                 same ids in both variants. -->
            <LinearLayout
                android:id="@+id/portraitDrawer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:minHeight="140dp"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/card_dark"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/portraitDrawerHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/ic_apps" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/all_apps"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- One page of app tiles, built in code; swipe to change page -->
                <com.dashline.launcher.SwipeLinearLayout
                    android:id="@+id/portraitDrawerGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <!-- Page dots; swipe the grid or tap a dot to change page -->
                <LinearLayout
                    android:id="@+id/portraitDrawerDots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===== Bottom tab bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/tabBar"
        android:layout_height="@dimen/tab_bar_height"
        android:orientation="horizontal"
        android:background="@color/bar"
        android:baselineAligned="false">
    </LinearLayout>
</LinearLayout>
